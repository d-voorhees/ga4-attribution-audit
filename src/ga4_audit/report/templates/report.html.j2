<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>{{ client_name }} GA4 Attribution Audit</title>
  <style>
    body { font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif; line-height: 1.6; max-width: 960px; margin: 0 auto; padding: 2rem; color: #1a1a1a; }
    h1 { border-bottom: 2px solid #2563eb; padding-bottom: 0.5rem; }
    h2 { color: #1e40af; margin-top: 2rem; }
    h3 { color: #374151; }
    table { border-collapse: collapse; width: 100%; margin: 1rem 0; font-size: 0.9rem; }
    th, td { border: 1px solid #d1d5db; padding: 0.5rem 0.75rem; text-align: left; }
    th { background: #f3f4f6; font-weight: 600; }
    tr:nth-child(even) { background: #f9fafb; }
    .severity-critical { color: #dc2626; font-weight: 600; }
    .severity-warning { color: #d97706; font-weight: 600; }
    .severity-info { color: #2563eb; }
    .severity-pass { color: #16a34a; }
    .summary-box { background: #eff6ff; border-left: 4px solid #2563eb; padding: 1rem; margin: 1rem 0; }
    .meta { color: #6b7280; font-size: 0.875rem; }
    ol { padding-left: 1.5rem; }
    li { margin-bottom: 0.5rem; }
  </style>
</head>
<body>
  <h1>{{ client_name }} GA4 Attribution Audit</h1>
  <p class="meta">Generated: {{ generated_at }}</p>

  <h2>Executive Summary</h2>
  <div class="summary-box">
    <p>This audit reviewed <strong>{{ session_count }}</strong> GA4 sessions, <strong>{{ conversion_count }}</strong> conversions, <strong>{{ callrail_count }}</strong> CallRail calls, and <strong>{{ ads_count }}</strong> Google Ads conversions.</p>
    <p><strong>Total issues found:</strong> {{ total_issues }}</p>
  </div>

  <table>
    <thead><tr><th>Audit</th><th>Severity</th><th>Issues</th><th>Summary</th></tr></thead>
    <tbody>
    {% for result in executive_summary %}
      <tr>
        <td>{{ result.name }}</td>
        <td class="severity-{{ result.severity }}">{{ result.severity | capitalize }}</td>
        <td>{{ result.issue_count }}</td>
        <td>{{ result.summary }}</td>
      </tr>
    {% endfor %}
    </tbody>
  </table>

  <h2>Audit Configuration</h2>
  <table>
    <tr><th>Property ID</th><td>{{ config.property_id }}</td></tr>
    <tr><th>Date range</th><td>{{ config.start_date }} to {{ config.end_date }}</td></tr>
    <tr><th>Conversion events</th><td>{{ config.conversion_events | join(', ') }}</td></tr>
    <tr><th>Duplicate window</th><td>{{ config.duplicate_window_minutes }} minutes</td></tr>
    <tr><th>GA4 source</th><td>{{ source_modes.get('ga4', 'unknown') }}</td></tr>
    <tr><th>CallRail source</th><td>{{ source_modes.get('callrail', 'unknown') }}</td></tr>
    <tr><th>Google Ads source</th><td>{{ source_modes.get('google_ads', 'unknown') }}</td></tr>
  </table>

  {% for result in results %}
  <h2>{{ result.name }}</h2>
  <p>{{ result.summary }}</p>
  {% if result.findings %}
  <table>
    <thead>
      <tr>{% for key in result.findings[0].keys() %}<th>{{ key | replace('_', ' ') | title }}</th>{% endfor %}</tr>
    </thead>
    <tbody>
    {% for finding in result.findings %}
      <tr>{% for key in result.findings[0].keys() %}<td>{{ finding.get(key, '') }}</td>{% endfor %}</tr>
    {% endfor %}
    </tbody>
  </table>
  {% else %}
  <p><em>No findings for this check.</em></p>
  {% endif %}
  {% endfor %}

  <h2>Methodology Notes</h2>
  {% for result in results %}
  <h3>{{ result.name }}</h3>
  <p>{{ result.methodology }}</p>
  {% endfor %}

  <h2>Recommended Next Steps</h2>
  <ol>
  {% for rec in recommendations %}
    <li>{{ rec }}</li>
  {% endfor %}
  </ol>

  <p class="meta">Report generated by ga4-attribution-audit.</p>
</body>
</html>
